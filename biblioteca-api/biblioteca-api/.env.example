# Renomeie este arquivo para ".env" e ajuste conforme necessário

# String de conexão do MongoDB (local ou Atlas)
# Local:
MONGO_URI=mongodb://127.0.0.1:27017/biblioteca

# Atlas (exemplo):
# MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/biblioteca

# Porta em que a API vai rodar
PORT=3000

# JWT_SECRET=seu_segredo_jwt_aqui
JWT_SECRET=sua-chave-muito-segura

## Exemplo de token JWT para testes (não use em produção)
# eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY0YjE3YjE3YjE3YjE3YjE3YjE3

NODE_ENV=development
